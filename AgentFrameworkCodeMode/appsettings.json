{
  "Logging": {
    "LogLevel": {
      "System.Net.Http.HttpClient": "Warning",
      "Default": "Information"
    }
  },
  "EnableOpenTelemetry": true,
  "Embedding": {
    "ModelEndpoint": "https://router.huggingface.co/scaleway/v1/embeddings",
    "ModelName": "qwen3-embedding-8b"
  },
  "QDrant": {
    "Host": "qdrant.dem-k8s.home",
    "Port": 443,
    "Https": true,
    "VectorSize": 4096
  },
  "SESJSSandbox": {
    "MCPServerAgentId": "agent-31c579ef-6aba-4e8e-ba12-c3a76be05fea"
  },
  "InferenceProviders": {
    "HuggingFace": {
      "Endpoint": "https://router.huggingface.co/v1"
    },
    "Together": {
      "Endpoint": "https://api.together.xyz/v1/"
    },
    "FireworksAI": {
      "Endpoint": "https://api.fireworks.ai/inference/v1/"
    }
  },
  "LLMs": {
    "ContextAnalyzerLLM": {
      "CostPerMillionInputTokens": "0.05",
      "CostPerMillionOutputTokens": "0.20",
      "Model": "openai/gpt-oss-20b",
      "Provider": "Together"
    },
    "CoderLLM": {
      "CostPerMillionInputTokens": "0.05",
      "CostPerMillionOutputTokens": "0.20",
      "Model": "openai/gpt-oss-20b",
      "Provider": "Together"
    },
    "20B-Class-LLM": {
      "CostPerMillionInputTokens": "0.04",
      "CostPerMillionOutputTokens": "0.15",
      "Model": "openai/gpt-oss-20b:novita",
      "Provider": "HuggingFace"
    },
    "8B-Class-LLM": {
      "CostPerMillionInputTokens": "0.02",
      "CostPerMillionOutputTokens": "0.05",
      "Model": "meta-llama/Llama-3.1-8B-Instruct:novita",
      "Provider": "HuggingFace"
    },
    "3B-Class-LLM": {
      "CostPerMillionInputTokens": "0.02",
      "CostPerMillionOutputTokens": "0.04",
      "Model": "google/gemma-3n-E4B-it",
      "Provider": "Together"
    }
  },
  "Agents": {
    "BusinessAdvisor": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.0",
      "SystemPromptFile": "Prompts/BusinessAdvisor.SystemPrompt.txt",
      "UseStructuredOutput": false
    },
    "BusinessAnalyst": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/BusinessAnalyst.SystemPrompt.txt",
      "UseStructuredOutput": true,
      "StructuredOutputFQCN": "AgentFrameworkCodeMode.Models.StructuredOutputs.BusinessAnalystAgentOutput",
      "StructuredOutputDescription": "A JSON object with 'ProgramSpecification' (a string containing the complete business requirements) and 'FunctionsList' (an array of function names from the documentation) properties."
    },
    "Coder": {
      "LLM": "CoderLLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/Coder.SystemPrompt.txt",
      "UseStructuredOutput": false
    },
    "ResultsPresenter": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/ResultsPresenter.SystemPrompt.txt",
      "UseStructuredOutput": false
    },
    "CodeFixer": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/CodeFixer.SystemPrompt.txt",
      "UseStructuredOutput": false
    },
    "CodeExecutionFailuresDetector": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/CodeExecutionFailuresDetector.SystemPrompt.txt",
      "UseStructuredOutput": false
    },
    "CodeStaticAnalyzer": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/CodeStaticAnalyzer.SystemPrompt.txt",
      "UseStructuredOutput": false
    },
    "ContextAnalyzer": {
      "LLM": "ContextAnalyzerLLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/ContextAnalyzer.SystemPrompt.txt",
      "UseStructuredOutput": true,
      "StructuredOutputFQCN": "AgentFrameworkCodeMode.Models.StructuredOutputs.ContextAnalyzerAgentOutput",
      "StructuredOutputDescription": "A JSON object with a 'KeyFacts' list (a list of key facts about the subject of the user's request). Or an empty list if nothing relevant is found."

    },
    "Router": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/Router.SystemPrompt.txt",
      "UseStructuredOutput": true,
      "StructuredOutputFQCN": "AgentFrameworkCodeMode.Models.StructuredOutputs.RouterAgentOutput",
      "StructuredOutputDescription": "A JSON object with 'RequestSubject' (a short string describing the subject of the user's request) and 'Rationale' (a short string describing the rationale behind the routing decision) properties."
    },
    "Translator": {
      "LLM": "3B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/Translator.SystemPrompt.txt",
      "UseStructuredOutput": false
    },
    "PersonalAssistant": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/PersonalAssistant.SystemPrompt.txt",
      "UseStructuredOutput": false
    },
    "ConversationSummarizer": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/ConversationSummarizer.SystemPrompt.txt",
      "SummaryTokenThreshold": 4000,
      "NumMessageToPreseve": 12,
      "SummarizeLanguage": "Italian",
      "UseStructuredOutput": false
    }
  }
}
